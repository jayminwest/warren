{
	"files": [],
	"references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }],
	// Bun test resolves the `@/` alias through the nearest tsconfig with a
	// `paths` block; the solution file mirrors tsconfig.app.json's mapping
	// so *.test.ts(x) files under src/ui import UI modules directly.
	"compilerOptions": {
		"baseUrl": ".",
		"paths": { "@/*": ["./src/*"] }
	}
}
